      </mxCell>
      <mxCell id="sort" parent="1" style="rounded=0;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;spacing=5;fillColor=#F1F1F1;strokeColor=#555555;strokeWidth=2;fontColor=#171717;fontSize=22;fontFamily=Helvetica;" value="&lt;div style=&quot;font-size:22px&quot;&gt;&lt;b&gt;Rank the matching reports&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-size:18px;margin-top:5px&quot;&gt;Use the four rules at right to order the list.&lt;/div&gt;" vertex="1">
