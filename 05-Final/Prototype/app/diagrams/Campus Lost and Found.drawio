        <mxGeometry height="103" width="307" x="246" y="213" as="geometry" />
      </mxCell>
      <mxCell id="error" parent="1" style="rounded=1;absoluteArcSize=1;arcSize=50;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;spacing=5;fillColor=#EEEEEE;strokeColor=#3B3B3B;strokeWidth=2;fontColor=#171717;fontSize=21;fontFamily=Helvetica;" value="&lt;div style=&quot;font-size:21px&quot;&gt;&lt;b&gt;Show the input error&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-size:16px;margin-top:5px&quot;&gt;Departure must follow arrival. Both times must be in the past or present.&lt;br&gt;Visits to different places must not overlap.&lt;/div&gt;" vertex="1">
        <mxGeometry height="93" width="600" x="774" y="218" as="geometry" />
      </mxCell>
      <mxCell id="pairs" parent="1" style="rounded=0;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;spacing=5;fillColor=#F1F1F1;strokeColor=#555555;strokeWidth=2;fontColor=#171717;fontSize=22;fontFamily=Helvetica;" value="&lt;div style=&quot;font-size:22px&quot;&gt;&lt;b&gt;Select available finds at the same place&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-size:17px&quot;&gt;Skip claimed items. Require the same category and place ID.&lt;br&gt;A known room alias uses the same ID as its room.&lt;br&gt;The item must have been found at or after arrival.&lt;/div&gt;" vertex="1">
        <mxGeometry height="102" width="668" x="65" y="351" as="geometry" />
      </mxCell>
      <mxCell id="best" parent="1" style="rounded=0;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;spacing=5;fillColor=#F1F1F1;strokeColor=#555555;strokeWidth=2;fontColor=#171717;fontSize=22;fontFamily=Helvetica;" value="&lt;div style=&quot;font-size:22px&quot;&gt;&lt;b&gt;Keep each matching report once&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-size:18px;margin-top:5px&quot;&gt;If several visits qualify for the same report, use its best visit.&lt;br&gt;Discard reports that have no eligible visit.&lt;/div&gt;" vertex="1">
